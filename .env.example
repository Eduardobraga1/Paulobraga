# Database
DATABASE_URL="postgresql://user:password@localhost:5432/educlass?schema=public"
# For development, you can use SQLite:
# DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# Google OAuth (optional, get from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# WhatsApp Cloud API (get from https://developers.facebook.com/)
# After creating a Meta App and adding WhatsApp product
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_ACCESS_TOKEN="your-permanent-access-token"
WHATSAPP_VERIFY_TOKEN="your-webhook-verify-token-choose-any-string"

# Vercel Blob Storage (for audio files)
# Get from https://vercel.com/dashboard/stores
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token"

# App URL (for webhooks and public links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
